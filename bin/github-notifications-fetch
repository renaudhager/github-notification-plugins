#!/usr/bin/env bash
# GitHub notifications for the Omarchy GitHub notifications widget.
#
# Prints one JSON object on stdout and always exits 0: problems are reported
# in the `error` field so the widget can keep its last good state. Auth is
# delegated entirely to the gh CLI credential store.
#
# Usage:
#   github-notifications-fetch [--config JSON] [--mark-done ID]
#
#   --config JSON    {"rules":[{"pattern":"repo/*","action":"ack"|"ignore"}]}
#                    Rule actions: `ack` and `ignore` both hide matching
#                    threads from the counted number; `ack` also marks them
#                    read on GitHub, `ignore` leaves them alone there.
#   --mark-done ID   Mark one notification thread done and exit (GitHub's
#                    inbox "Done": it leaves the inbox for the Done tab,
#                    which is stronger than merely marking it read).
#
# Output:
#   {
#     "ok": true, "login": "octocat", "fetchedAt": "2026-...Z",
#     "counted": 12, "acked": 3, "ignored": 2, "ackedPending": 1,
#     "notifications": [{id, repo, title, reason, type, updatedAt, url}],
#     "ackedItems": [{id, repo, title, reason, type, updatedAt, url}],
#     "errors": []
#   }
#
#   `url` is the page the widget opens on click: the pull request, issue,
#   discussion, release, commit or action run the notification is about, not
#   the repository.
set -uo pipefail

PER_PAGE=50
MAX_PAGES=40
WORK="$(mktemp -d)" || exit 1
trap 'rm -rf "$WORK"' EXIT

# ---------------------------------------------------------------- arguments
config=""
mark_done=""
while (($#)); do
  case "$1" in
    --config) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; config=$2; shift 2 ;;
    --mark-done) [[ $# -ge 2 ]] || { echo "missing value for $1" >&2; exit 2; }; mark_done=$2; shift 2 ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done

# ---------------------------------------------------------------- helpers
# The shell that runs plugins may not inherit mise/asdf shims on PATH; append
# their directories so a `jq` installed that way still resolves.
for dir in "$HOME/.local/bin" "$HOME/.local/share/mise/shims" "$HOME/.asdf/shims"; do
  case ":$PATH:" in *":$dir:"*) ;; *) [[ -d $dir ]] && PATH="$PATH:$dir" ;; esac
done
export PATH

fail() {
  jq -nc --arg message "$1" '{ok:false,error:$message,login:"",fetchedAt:null,counted:0,acked:0,ignored:0,
    notifications:[],ackedItems:[],ackedPending:0,errors:[]}'
  exit 0
}

command -v jq >/dev/null 2>&1 || {
  echo '{"ok":false,"error":"jq is required","counted":0,"acked":0,"ignored":0,"notifications":[],"ackedItems":[],"ackedPending":0,"errors":[]}'
  exit 0
}
command -v curl >/dev/null 2>&1 || fail "curl is required"
command -v gh >/dev/null 2>&1 || fail "GitHub CLI (gh) is not installed or not on PATH"

token=$(gh auth token -h github.com 2>/dev/null) || token=""
[[ -n $token ]] || fail "Not signed in. Run 'gh auth login' (scopes: notifications, repo)."

if [[ -n $mark_done ]]; then
  [[ $mark_done =~ ^[0-9]+$ ]] || { jq -nc '{ok:false,error:"Invalid notification id"}'; exit 0; }
  # DELETE is "done"; PATCH would only mark it read and leave it in the inbox.
  if gh api --method DELETE "/notifications/threads/$mark_done" >/dev/null 2>&1; then
    jq -nc '{ok:true,markedDone:true}'
  else
    jq -nc '{ok:false,error:"Could not mark the notification done"}'
  fi
  exit 0
fi

# ---------------------------------------------------------------- rules
# Every rule is compiled to a (kind, repo, regex, key, action) record, and the
# match runs in the same jq pass that shapes the output, so a long list stays
# cheap even on a big inbox.
#
# Patterns:
#   owner/repo           exact repository
#   owner/*              every repository of that owner
#   owner/repo#pull      PRs only      (#pull, #pr, #pullRequest)
#   owner/repo#issue     issues only   (#issue)
#   all of the above with #<number> for one specific thread
#   owner/repo#any       any subject   (same as owner/repo)
#   bare words           repository name, subject type (pullRequest, issue,
#                        discussion, release, commit, checkSuite, ...) or
#                        notification reason (review_requested, assign,
#                        comment, subscribed, mention, ...)
# The first matching rule wins, top to bottom.
rules=${config:-'{"rules":[]}'}
jq -en --argjson c "$rules" '($c.rules // []) | type == "array"' >/dev/null 2>&1 \
  || rules='{"rules":[]}'

compile_rules() {
  local out="[]" row pattern action base sel sel_kind re
  while IFS= read -r row; do
    pattern=$(jq -r '.pattern | ascii_downcase | gsub("^\\s+|\\s+$"; "")' <<<"$row")
    action=$(jq -r '.action' <<<"$row")
    [[ -n $pattern ]] || continue
    if [[ $pattern == *'#'* ]]; then
      base=${pattern%%#*}
      sel=${pattern#*\#}
      # Anything that is not purely digits must be a named selector below.
      [[ $sel =~ ^[0-9]+$ ]] && sel_kind=number || sel_kind=$sel
      case "${sel_kind,,}" in
        any|'') re='';;
        pull|pr|pullrequest|pull_request) re='^https://api\.github\.com/repos/[^/]+/[^/]+/pulls/[0-9]+$';;
        issue) re='^https://api\.github\.com/repos/[^/]+/[^/]+/issues/[0-9]+$';;
        discussion) re='^https://api\.github\.com/repos/[^/]+/[^/]+/discussions/[0-9]+$';;
        release) re='^https://api\.github\.com/repos/[^/]+/[^/]+/releases/[0-9]+$';;
        number) re="^https://api\\.github\\.com/repos/[^/]+/[^/]+/(pulls|issues|discussions|releases)/$sel\$";;
        *) re='^$';;
      esac
      if [[ $base == */* ]]; then
        out=$(jq -c --arg repo "$base" --arg re "$re" --arg action "$action" \
          '. + [{kind:"repo", repo:$repo, url:$re, key:"", action:$action}]' <<<"$out")
      else
        # A bare word with a subject filter only has a key to match on.
        out=$(jq -c --arg key "$base" --arg action "$action" \
          '. + [{kind:"key", repo:"", url:"", key:$key, action:$action}]' <<<"$out")
      fi
    elif [[ $pattern == */* ]]; then
      out=$(jq -c --arg repo "$pattern" --arg action "$action" \
        '. + [{kind:"repo", repo:$repo, url:"", key:"", action:$action}]' <<<"$out")
    else
      out=$(jq -c --arg key "$pattern" --arg action "$action" \
        '. + [{kind:"key", repo:"", url:"", key:$key, action:$action}]' <<<"$out")
    fi
  done < <(jq -c '(.rules // [])[] | select(.action == "ack" or .action == "ignore")' <<<"$rules")
  printf '%s\n' "$out"
}

rule_list=$(compile_rules)

# ---------------------------------------------------------------- fetch
# GitHub caps the notifications list at 50 items per page regardless of the
# requested per_page, so stay at 50 and read the Link header to know when to
# stop. Reading raw with curl (instead of `gh api`) keeps the Link header and
# the rate-limit budget identical to what `gh api` would use.
pages=1
errors="[]"
: >"$WORK/pages.jsonl"
while ((pages <= MAX_PAGES)); do
  url="https://api.github.com/notifications?all=false&per_page=$PER_PAGE&page=$pages"
  if ! curl -sS -m 30 -D "$WORK/headers" \
      -H "Authorization: Bearer $token" \
      -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" \
      -H "User-Agent: omarchy-github-notifications" \
      "$url" >"$WORK/body" 2>"$WORK/curl.err"; then
    ((pages == 1)) && fail "Could not reach GitHub (network error)"
    errors=$(jq -c --arg e "Network error on page $pages" '. + [$e]' <<<"$errors")
    break
  fi
  if ! jq -e 'type == "array"' "$WORK/body" >/dev/null 2>&1; then
    msg=$(jq -r '.message // empty' "$WORK/body" 2>/dev/null)
    if [[ -z $msg ]]; then
      ((pages == 1)) && fail "GitHub returned an unexpected response"
      errors=$(jq -c --arg e "Unexpected response on page $pages" '. + [$e]' <<<"$errors")
      break
    fi
    ((pages == 1)) && fail "GitHub API error: $msg"
    errors=$(jq -c --arg e "Page $pages: $msg" '. + [$e]' <<<"$errors")
    break
  fi
  jq -c '.' "$WORK/body" >>"$WORK/pages.jsonl"
  grep -qi '^link:.*rel="next"' "$WORK/headers" || break
  ((pages++))
done

jq -s 'add // []' "$WORK/pages.jsonl" >"$WORK/all.json" 2>/dev/null || echo '[]' >"$WORK/all.json"

# ---------------------------------------------------------------- shape
# `url` is what the row opens: the pull request, issue, discussion, release,
# commit or action run the notification is about, never just the repository.
# The subject URL is an API URL, so it is mapped onto its page here. Pulls
# and issues share a number space, and GitHub files a notification under
# `Issue` even when the number belongs to a pull request, so an issue subject
# is checked once and becomes `/pull/<n>` when it is really a PR.
jq --argjson rules "$rule_list" '
  # Rule matching is a filter over the notification. Note that `select`
  # rebinds its input to the pass/fail test result, so the helpers run the
  # test as an argument (`$n | rule_hit($r)`) and return a boolean.
  def rule_hit($r):
    . as $n
    | ($n.repo | split("/")) as $parts
    | if $r.kind == "repo" then
        (if ($r.repo | endswith("/*")) then ($parts | first) else $n.repo end) == ($r.repo | rtrimstr("/*"))
        and ($r.url == "" or (($n.subjectUrl // "") | test($r.url)))
      else
        # A bare word matches the repository, its name alone, the subject
        # type or the notification reason.
        [$n.repo, ($parts | last), $n.type, $n.reason]
        | map((. // "") | tostring | ascii_downcase) | index($r.key) != null
      end;
  def tag($rules):
    ([$rules[] as $r | select(rule_hit($r)) | $r.action] | first) // "count";
  def repo_page($n):
    if ($n.repository.html_url // "") != "" then $n.repository.html_url
    elif ($n.repository.full_name // "") != "" then "https://github.com/" + $n.repository.full_name
    else "https://github.com/notifications" end;
  # The web page for an API subject URL. `/pulls/7` is `/pull/7`; every other
  # kind (issues, discussions, commits, releases) keeps its path.
  def subject_page($n):
    ($n.subject.url // "") as $api
    | if ($api | startswith("https://api.github.com/repos/")) | not then ""
      else $api
        | sub("^https://api\\.github\\.com/repos/"; "https://github.com/")
        | sub("/pulls/(?<n>[0-9]+)$"; "/pull/\(.n)")
      end;
  def base:
    . as $n
    | {
        id: $n.id,
        repo: ($n.repository.full_name // ""),
        owner: ($n.repository.owner.login // ($n.repository.full_name // "" | sub("/.*$"; ""))),
        title: ($n.subject.title // ""),
        reason: ($n.reason // ""),
        type: ($n.subject.type // ""),
        updatedAt: ($n.updated_at // ""),
        unread: ($n.unread // false),
        subjectUrl: ($n.subject.url // ""),
        url: (subject_page($n) | if . == "" then repo_page($n) else . end)
      };
  [ .[] | base | . as $b | $b + {action: ($b | tag($rules))} ] as $all
  | [ $all[] | select(.action == "ack") ] as $ack
  | [ $all[] | select(.action != "ack") ] as $rest
  | {
      notifications: [ $rest[] | select(.unread) | del(.subjectUrl, .unread, .action, .owner) ],
      ackedItems: [ $ack[] | select(.unread) | del(.subjectUrl, .unread, .action, .owner) ],
      ackedPending: [ $ack[] | select(.unread) ] | length,
      ignored: [ $rest[] | select(.action == "ignore") | select(.unread) ] | length
    }
' "$WORK/all.json" >"$WORK/shaped.json" || {
  fail "Could not parse the GitHub response"
}

# ---------------------------------------------------------------- issues
# An issue-numbered notification may belong to a pull request. One GET per
# such row decides which; a public repository costs half a rate-limit unit,
# a private one nothing. Rows keep their issue page if the check fails.
while IFS= read -r line; do
  [[ -n $line ]] || continue
  repo=${line%% *}
  number=${line##* }
  if [[ $(gh api "repos/$repo/issues/$number" --jq 'has("pull_request")' 2>/dev/null) == true ]]; then
    page="https://github.com/$repo/pull/$number"
    jq -c --arg page "$page" '
      .notifications |= map(if .subjectUrl == "https://api.github.com/repos/" + ($ARGS.named.repo) + "/issues/" + ($ARGS.named.number) then .url = $page else . end)
      | .ackedItems |= map(if .subjectUrl == "https://api.github.com/repos/" + ($ARGS.named.repo) + "/issues/" + ($ARGS.named.number) then .url = $page else . end)
    ' --arg repo "$repo" --arg number "$number" "$WORK/shaped.json" >"$WORK/reshaped.json" \
      && mv "$WORK/reshaped.json" "$WORK/shaped.json"
  fi
done < <(jq -r '(.notifications + .ackedItems)[]
  | select((.subjectUrl // "") | test("/issues/[0-9]+$"))
  | .repo + " " + ((.subjectUrl | capture("/issues/(?<n>[0-9]+)$")).n)' "$WORK/shaped.json")

# ---------------------------------------------------------------- acknowledge
# Mark every unread thread an `ack` rule matched done on GitHub, so it drops
# out of the inbox on the next poll instead of coming back forever.
while IFS= read -r id; do
  [[ $id =~ ^[0-9]+$ ]] || continue
  gh api --method DELETE "/notifications/threads/$id" >/dev/null 2>&1 \
    || errors=$(jq -c --arg e "Could not mark thread $id done" '. + [$e]' <<<"$errors")
done < <(jq -r '.ackedItems[].id' "$WORK/shaped.json")

login=$(gh api user --jq .login 2>/dev/null) || login=""
jq -c --arg login "$login" --argjson errors "$errors" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
  {
    ok: true,
    login: $login,
    fetchedAt: $now,
    counted: (.notifications | length),
    acked: (.ackedItems | length),
    ignored: .ignored,
    notifications: .notifications,
    ackedItems: .ackedItems,
    ackedPending: .ackedPending,
    errors: $errors
  }
' "$WORK/shaped.json"
